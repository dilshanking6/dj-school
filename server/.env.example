# ============================================================
#  DIGITAL JANTA — SERVER ENVIRONMENT
#  Copy this file to `.env` and fill in real values.
#  Never commit the real `.env`.
# ============================================================

# --- HTTP server -------------------------------------------------
PORT=5000
# Production me ye set karo — frontend ka origin (e.g. https://school.example.com)
CLIENT_ORIGIN=http://localhost:5173

# --- Auth / sessions ----------------------------------------------
# Random 32+ char string. Change for every deployment.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# OTP (signup/verify) kitne der tak valid rahe — ms
OTP_TTL_MS=300000

# --- Google Sheets (Apps Script) ----------------------------------
# Script do endpoints deta hai: read & write (POST JSON).
# Column schema -> see README "Study content" section.
APPS_SCRIPT_URL=
# Apps Script timeout/quota se bachne ke liye:
SHEET_READ_TIMEOUT=90000
SHEET_WRITE_TIMEOUT=90000
SHEET_READ_ATTEMPTS=2
SHEET_WRITE_ATTEMPTS=2
# Har write (append/update/delete) par cache turant khaali hota hai.
# Ye sirf network round-trips kam karta hai (speed) — data fresh rehta hai.
SHEET_CACHE_TTL_MS=8000

# StudyContent sheet read cache (notes merge hone tak) — ms
STUDY_OVERRIDE_TTL_MS=120000

# --- Email OTP (verification codes) ---------------------------------
# Registration ka verification code Gmail par bhejne ke liye.
# Gmail SMTP + App Password use hota hai (password nahi, app password).
#
#   1. Google Account -> Security -> 2-Step Verification ON karo
#   2. Security -> App passwords -> "Mail" select -> 16 char password
#   3. Wahi 16 char password SMTP_PASS me dalo
#
# Ye set na ho to sirf Mobile verification kaam karega.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your.school@gmail.com
SMTP_PASS=
# Inhe set karne se "from" address fix ho jaata hai (warna SMTP_USER).
# Gmail par apna naam add kar lena, warna mail spam me jata hai.
MAIL_FROM="Digital Janta" <your.school@gmail.com>

# Sirf development ke liye: OTP screen par bhi dikhaya jaaye.
# Production me KABHI true mat karna — koi bhi bina mail padhe code use kar lega.
ALLOW_DEV_EMAIL_CODE=

# Sirf gmail.com allow hai. Comma se aur domains jod sakte ho.
ALLOWED_EMAIL_DOMAINS=gmail.com

# --- SMS OTP (mobile verification) -----------------------------------
# Mobile number pe OTP bhejne ke liye ek (free) provider chuno. Teen
# supported hain — ek hi time me ek hi set karo:
#
#   SMS_PROVIDER=fast2sms  fast2sms.com/dev-api par free signup credits.
#                          SMS_API_KEY me unka API token.
#   SMS_PROVIDER=2factor   2factor.in par free trial credits.
#                          SMS_API_KEY me API key.
#   SMS_PROVIDER=webhook   apna koi bhi gateway. SMS_WEBHOOK_URL par
#                          server POST karta hai: { to, message, code }.
#                          200 + { "error": "..." } = failure.
#
# 10 digit ka Indian number hi daalna hai ("9876543210"). Server khud
# country code 91 laga deta hai (0 ya +91 hata deta hai).
SMS_PROVIDER=
SMS_API_KEY=
SMS_WEBHOOK_URL=
# Fast2SMS ke liye: 'q' = Quick SMS (DLT ke bina, default, aasaani se chalta hai).
# 'dlt' ke liye SMS_F2S_SENDER_ID (6 letter DLT header) aur SMS_F2S_TEMPLATE
# (approved template ID) dono chahiye — tabhi message pahunchta hai.
SMS_F2S_ROUTE=q
SMS_F2S_SENDER_ID=
SMS_F2S_TEMPLATE=
# Provider tak pahunchne me kitna wait (ms).
SMS_TIMEOUT=10000

# --- AI tutor (optional) --------------------------------------------
# Free-form ChatGPT-style answers ke liye. Khali ho to local syllabus
# notes + maths solver hi use hote hain.
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=30000
AI_TEMPERATURE=0.4
# Per-user (/api/ai/chat par per-IP for guests) rate limits — per minute
AI_RATE_MAX=20
AI_HTTP_RATE_MAX=30

# --- Misc -----------------------------------------------------------
# production par stack traces chhup jaate hain
NODE_ENV=development